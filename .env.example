# ── Supabase (production backend: Postgres + Auth + RLS) ─────────────────────
# Leave these UNSET to run EduNexus in demo mode (browser localStorage) so the
# app is fully clickable without any backend. Set both to switch to Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── AI study-priority recommendation (server-side only) ──────────────────────
# Optional. Uses any OpenAI-compatible Chat Completions API.
# If unset, the server returns the deterministic rule-based recommendation
# (overdue → nearest deadline → high priority) — the app never breaks.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
